# Flow Hub derived runtime caches
/runtime/agent_context.json
/runtime/flow/*.json
/runtime/inbox_review/*.json
/runtime/reminders/*.json
!/runtime/.gitkeep
!/runtime/flow/.gitkeep

# Agent Runtime derived SQLite store
/runtime/agent/
/runtime/agent/*.sqlite
/runtime/agent/*.sqlite-*

# Local runtime bootstrap profile, process ledger, and logs
/runtime/local/

# PKOS local operational logs
/inbox/*.jsonl
/state/*.jsonl
!/inbox/.gitkeep
!/state/.gitkeep

# Node dependencies
node_modules/

# Web Dashboard generated output
/apps/web-dashboard/dist/
/apps/web-dashboard/dist-smoke/
/apps/web-dashboard/dist-task-due-picker-smoke/
/apps/desktop/dist/
/packages/agent-client/dist/

__pycache__/
*.py[cod]
