{
  "name": "@pkos/desktop",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "check": "tsc --noEmit && tsc -p tsconfig.main.json --noEmit",
    "build": "tsc -p tsconfig.main.json && vite build",
    "smoke": "tsx src/scripts/smoke.ts",
    "chat-stream-probe": "tsx src/scripts/chatStreamProbe.ts",
    "chat-restart-restore-smoke": "tsx src/scripts/chatRestartRestoreSmoke.ts",
    "chat-history-retry-smoke": "tsx src/scripts/chatHistoryRetrySmoke.ts",
    "chat-history-connectivity-probe": "electron . --pkos-chat-history-connectivity-probe",
    "window-probe": "electron . --pkos-window-probe",
    "connectivity-probe": "electron . --pkos-connectivity-probe"
  },
  "dependencies": {
    "@pkos/agent-client": "file:../../packages/agent-client",
    "electron": "^39.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
