{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "rootDir": "src",
    "outDir": "dist-smoke"
  },
  "include": [
    "src/scripts/smoke.ts",
    "src/features/actions/requestAttempt.ts",
    "src/features/inbox-review/inboxReviewModel.ts",
    "src/features/state/stateModel.ts",
    "src/lib/guards.ts",
    "src/types.ts"
  ]
}
