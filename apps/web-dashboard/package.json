{
  "name": "@pkos/web-dashboard",
  "version": "0.6.0-skeleton",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "check": "tsc --noEmit",
    "build": "vite build",
    "smoke": "tsc -p tsconfig.smoke.json && node dist-smoke/scripts/smoke.js",
    "task-due-picker-smoke": "tsc -p tsconfig.task-due-picker-smoke.json && node dist-task-due-picker-smoke/scripts/taskDuePickerSmoke.js",
    "review-web-smoke": "tsc -p tsconfig.review-web-smoke.json && node dist-review-web-smoke/scripts/reviewWebSmoke.js",
    "review-race-smoke": "node scripts/reviewRaceSmoke.mjs",
    "locale-smoke": "node scripts/localeSmoke.mjs",
    "ui-visual-smoke": "node scripts/uiVisualSmoke.mjs",
    "ui-preview": "node scripts/uiPreview.mjs",
    "object-web-smoke": "tsc -p tsconfig.object-web-smoke.json && node dist-object-web-smoke/scripts/objectWebSmoke.js"
  },
  "dependencies": {
    "@pkos/agent-client": "file:../../packages/agent-client",
    "lucide-react": "^1.48.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
